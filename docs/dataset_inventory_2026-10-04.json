  "queries": {
    "schema": "DESCRIBE TABLE caerus.order_book_states",
    "venue_totals": "SELECT exchange, count() AS rows,\n        toString(min(fromUnixTimestamp64Nano(toInt64(local_ts_ns),'UTC'))) AS first_receive_utc,\n        toString(max(fromUnixTimestamp64Nano(toInt64(local_ts_ns),'UTC'))) AS last_receive_utc,\n        countIf(exchange_ts_ns > local_ts_ns) AS negative_clock_age_rows,\n        min(length(bid_prices)) AS min_bid_depth, max(length(bid_prices)) AS max_bid_depth,\n        min(length(ask_prices)) AS min_ask_depth, max(length(ask_prices)) AS max_ask_depth\n        FROM caerus.order_book_states GROUP BY exchange ORDER BY exchange",
    "daily_counts": "SELECT toString(toDate(fromUnixTimestamp64Nano(toInt64(local_ts_ns),'UTC'))) AS day,\n        exchange, count() AS rows FROM caerus.order_book_states\n        GROUP BY day,exchange ORDER BY day,exchange"
  },
